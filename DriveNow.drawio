  <diagram id="GlujIqvSNv29cNeqK2bU" name="3-Questions-Assumptions">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="PMzzTeK_tL9UujWgEEOZ-8" parent="1" style="swimlane;whiteSpace=wrap;html=1;" value="Questions" vertex="1">
          <mxGeometry height="568" width="1000" x="-40" y="112" as="geometry" />
        </mxCell>
        <mxCell id="PMzzTeK_tL9UujWgEEOZ-10" parent="PMzzTeK_tL9UujWgEEOZ-8" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;li&gt;&lt;p dir=&quot;ltr&quot;&gt;&lt;b&gt;Section 7.1 (Branches and Staff):&lt;/b&gt;&lt;span class=&quot;&quot;&gt; When a branch manager resigns and a regional director temporarily takes over,&lt;/span&gt; is the regional director also stored as a regular employee in the &lt;code&gt;Employees&lt;/code&gt; table (and does the &quot;one branch at a time&quot; rule apply to them during temporary coverage)?&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p dir=&quot;ltr&quot;&gt;&lt;b&gt;Section 7.1 (Branches and Staff):&lt;/b&gt; If a person cannot be both a rental agent and a mechanic, can they hold other combinations of roles (e.g., a driver who also acts as an accountant or cleaner), or are all employee roles mutually exclusive?&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p dir=&quot;ltr&quot;&gt;&lt;b&gt;Section 7.2 (Training):&lt;/b&gt; What is the minimum passing score out of 100, and is it fixed globally across all courses or defined per course?&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p dir=&quot;ltr&quot;&gt;&lt;b&gt;Section 7.3 (Fleet, Categories, and Pricing):&lt;/b&gt; How should custom daily rates for specific luxury vehicles (like the Mercedes S-Class) be versioned over time so Finance can still verify historical rates, and do corporate/promo discounts apply to these custom vehicle rates?&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p dir=&quot;ltr&quot;&gt;&lt;b&gt;Section 7.3 (Fleet, Categories, and Pricing):&lt;/b&gt; Does the system need to log every historical vehicle status change (who changed it, when, old status, new status) in a dedicated audit/history table, or only track the latest status change?&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p dir=&quot;ltr&quot;&gt;&lt;b&gt;Section 7.5 (GPS Tracking):&lt;/b&gt; Can a GPS tracking device be uninstalled from one vehicle and reassigned to another over its lifecycle, or is the installation permanent?&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p dir=&quot;ltr&quot;&gt;&lt;b&gt;Section 7.7 &amp;amp; 8 (Customers &amp;amp; Stakeholder Notes):&lt;/b&gt; Since an authorized corporate driver can also be an individual customer (Section 8), should they share a single person/customer profile, or remain separate records where the corporate driver is treated as a weak entity dependent on the corporate account (Section 7.7)?&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p dir=&quot;ltr&quot;&gt;&lt;b&gt;Section 7.9 (Promotions):&lt;/b&gt; Can promo codes be used by corporate clients, or are they restricted exclusively to individual customers?&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p dir=&quot;ltr&quot;&gt;&lt;b&gt;Section 7.10 (Loyalty Program):&lt;/b&gt; What is the exact formula for earning points (e.g., points per EGP spent or per rental day), and are tier thresholds evaluated based on current redeemable balance or lifetime earned points?&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p dir=&quot;ltr&quot;&gt;&lt;b&gt;Section 7.11 (Reservations):&lt;/b&gt; How many hours after the scheduled pickup time does a &lt;code&gt;Confirmed&lt;/code&gt; reservation automatically or manually transition to &lt;code&gt;No-Show&lt;/code&gt;, and is there a cancellation/no-show fee?&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p dir=&quot;ltr&quot;&gt;&lt;b&gt;Section 7.12 (Rentals):&lt;/b&gt; How is the late return fee calculated (hourly vs. flat daily rate, grace period), and are extras/insurance daily charges automatically multiplied by the actual rental duration?&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p dir=&quot;ltr&quot;&gt;&lt;b&gt;Section 7.14 (Damage, Violations, and Feedback):&lt;/b&gt; Can a single traffic violation ever occur outside an active rental (e.g., during an employee branch transfer), and if so, should the system link violations to transfers/employees as well?&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p dir=&quot;ltr&quot;&gt;&lt;b&gt;Section 7.15 (Maintenance and Parts):&lt;/b&gt; Is a maintenance job card&#39;s &lt;code&gt;total cost&lt;/code&gt; calculated strictly as &lt;code&gt;(sum of parts used * historical unit cost) + labor cost&lt;/code&gt;, or is it entered manually? Also, are mechanic hourly labor rates stored in the system?&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p dir=&quot;ltr&quot;&gt;&lt;b&gt;Section 7.16 (Payments):&lt;/b&gt; How are monthly corporate invoices structured in the database—does one corporate invoice group multiple rentals, and how are payments linked to an invoice versus individual rentals?&lt;/p&gt;&lt;/li&gt;" vertex="1">
          <mxGeometry height="525" width="970" x="20" y="24" as="geometry" />
        </mxCell>
        <mxCell id="PMzzTeK_tL9UujWgEEOZ-11" parent="1" style="swimlane;whiteSpace=wrap;html=1;" value="Assumptions" vertex="1">
          <mxGeometry height="500" width="1000" x="-40" y="726" as="geometry" />
        </mxCell>
        <mxCell id="PMzzTeK_tL9UujWgEEOZ-12" parent="PMzzTeK_tL9UujWgEEOZ-11" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;li&gt;&lt;p dir=&quot;ltr&quot;&gt;&lt;b&gt;Section 7.1 (Branches and Staff):&lt;/b&gt; &lt;b&gt;Disjoint Specialization for Staff Roles:&lt;/b&gt; Employees are modeled using a supertype/subtype hierarchy (&lt;code&gt;Employee&lt;/code&gt; supertype with &lt;code&gt;RentalAgent&lt;/code&gt;, &lt;code&gt;Mechanic&lt;/code&gt;, and &lt;code&gt;OtherStaff&lt;/code&gt; subtypes), enforcing that an employee cannot simultaneously be a rental agent and a mechanic.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p dir=&quot;ltr&quot;&gt;&lt;b&gt;Section 7.1 (Branches and Staff):&lt;/b&gt; &lt;b&gt;Manager Assignment History:&lt;/b&gt; A separate &lt;code&gt;BranchManagerHistory&lt;/code&gt; associative entity (&lt;code&gt;Branch&lt;/code&gt; + &lt;code&gt;Employee&lt;/code&gt; + &lt;code&gt;StartDate&lt;/code&gt; + &lt;code&gt;EndDate&lt;/code&gt;) is used rather than a single foreign key on &lt;code&gt;Branch&lt;/code&gt;, allowing Head Office to track when each manager took over and preserve historical performance periods.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p dir=&quot;ltr&quot;&gt;&lt;b&gt;Section 7.3, 7.4, 7.13 (Pricing History):&lt;/b&gt; &lt;b&gt;Effective-Dated Rate Tables &amp;amp; Snapshots:&lt;/b&gt; Category rates, extras, and insurance packages each have effective-dated pricing tables (&lt;code&gt;StartDate&lt;/code&gt;, &lt;code&gt;EndDate&lt;/code&gt;) for historical lookup, while rental line items (&lt;code&gt;RentalExtra&lt;/code&gt;, &lt;code&gt;RentalInsurance&lt;/code&gt;, &lt;code&gt;Rental&lt;/code&gt;) also store a snapshot of the exact unit price charged at the time of rental.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p dir=&quot;ltr&quot;&gt;&lt;b&gt;Section 7.3 (Vehicle Status Audit):&lt;/b&gt; &lt;b&gt;Status Audit Log:&lt;/b&gt; A dedicated &lt;code&gt;VehicleStatusLog&lt;/code&gt; table (&lt;code&gt;VehicleID&lt;/code&gt;, &lt;code&gt;OldStatus&lt;/code&gt;, &lt;code&gt;NewStatus&lt;/code&gt;, &lt;code&gt;ChangedByEmployeeID&lt;/code&gt;, &lt;code&gt;ChangedAt&lt;/code&gt;) is included to satisfy management&#39;s requirement to trace who marked a car as &quot;Under Maintenance&quot; and when.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p dir=&quot;ltr&quot;&gt;&lt;b&gt;Section 7.7 (Customers):&lt;/b&gt; &lt;b&gt;Disjoint Customer Subtypes &amp;amp; Weak Corporate Drivers:&lt;/b&gt; &lt;code&gt;Customer&lt;/code&gt; is modeled as a disjoint supertype (&lt;code&gt;IndividualCustomer&lt;/code&gt; vs. &lt;code&gt;CorporateCustomer&lt;/code&gt;). &lt;code&gt;AuthorizedDriver&lt;/code&gt; is modeled as a weak entity identified by &lt;code&gt;(CorporateCustomerID, DriverSequenceNumber)&lt;/code&gt;, with an optional nullable foreign key to &lt;code&gt;IndividualCustomer&lt;/code&gt; to cross-reference drivers who also hold personal accounts.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p dir=&quot;ltr&quot;&gt;&lt;b&gt;Section 7.8 &amp;amp; 7.9 (Discounts):&lt;/b&gt; &lt;b&gt;Non-Stackable Discounts on Corporate Rentals:&lt;/b&gt; A corporate rental applies the active corporate contract discount for that vehicle category (capped at 50%), whereas promo codes apply only to individual reservations/rentals and cannot be stacked with corporate contract rates.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p dir=&quot;ltr&quot;&gt;&lt;b&gt;Section 7.10 (Loyalty Program):&lt;/b&gt; &lt;b&gt;Derived Tier &amp;amp; Ledger Design:&lt;/b&gt; Loyalty points are stored as an append-only transaction ledger (&lt;code&gt;LoyaltyTransaction&lt;/code&gt; with positive values for earned points and negative values for redemptions). A customer&#39;s current balance and tier (&lt;code&gt;Silver&lt;/code&gt;, &lt;code&gt;Gold&lt;/code&gt;, &lt;code&gt;Platinum&lt;/code&gt;) are derived from this ledger rather than manually edited.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p dir=&quot;ltr&quot;&gt;&lt;b&gt;Section 7.12 (Rentals):&lt;/b&gt; &lt;b&gt;Self-Referencing 1:1 Extension Chain:&lt;/b&gt; Rental extensions are modeled via a unique nullable foreign key &lt;code&gt;PreviousRentalID&lt;/code&gt; on the &lt;code&gt;Rental&lt;/code&gt; table, enforcing that one rental can be extended at most once directly while supporting multi-step extension chains.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p dir=&quot;ltr&quot;&gt;&lt;b&gt;Section 7.15 (Maintenance &amp;amp; Suppliers):&lt;/b&gt; &lt;b&gt;Supplier Catalog &amp;amp; Job Labor:&lt;/b&gt; &lt;code&gt;SupplierPart&lt;/code&gt; is modeled as a many-to-many associative table storing &lt;code&gt;UnitPrice&lt;/code&gt; and &lt;code&gt;LeadTimeDays&lt;/code&gt; per supplier-part pair, and &lt;code&gt;JobMechanic&lt;/code&gt; is modeled as a many-to-many associative table storing &lt;code&gt;HoursWorked&lt;/code&gt; per mechanic per job card.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p dir=&quot;ltr&quot;&gt;&lt;b&gt;Section 7.16 (Payments):&lt;/b&gt; &lt;b&gt;Corporate Invoicing Entity:&lt;/b&gt; A &lt;code&gt;CorporateInvoice&lt;/code&gt; entity is included to aggregate multiple corporate rentals for monthly billing, allowing payments to link either directly to a &lt;code&gt;Rental&lt;/code&gt; (for individual customers) or to a &lt;code&gt;CorporateInvoice&lt;/code&gt; (for corporate clients).&lt;/p&gt;&lt;/li&gt;" vertex="1">
          <mxGeometry height="440" width="970" x="20" y="35" as="geometry" />
        </mxCell>
        <mxCell id="PMzzTeK_tL9UujWgEEOZ-13" parent="1" style="swimlane;whiteSpace=wrap;html=1;" value="Contradictions" vertex="1">
          <mxGeometry height="727" width="1000" x="-40" y="1283" as="geometry" />
        </mxCell>
        <mxCell id="PMzzTeK_tL9UujWgEEOZ-14" parent="PMzzTeK_tL9UujWgEEOZ-13" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;li&gt;&lt;p dir=&quot;ltr&quot;&gt;&lt;b&gt;Corporate Driver Identity vs. Weak Entity Lifecycle (Section 7.7 vs. Section 8):&lt;/b&gt;&lt;/p&gt;&lt;ul dir=&quot;ltr&quot;&gt;&lt;li&gt;&lt;p dir=&quot;ltr&quot;&gt;&lt;b&gt;Section 7.7&lt;/b&gt; states that corporate authorized drivers &lt;i&gt;&quot;are only known through their company. Internally, each company numbers its drivers (Driver 1, Driver 2, and so on). If a corporate account is closed, its driver list has no meaning anymore.&quot;&lt;/i&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p dir=&quot;ltr&quot;&gt;&lt;b&gt;Section 8 (Ms. Rana Adel)&lt;/b&gt; states that &lt;i&gt;&quot;Some corporate drivers are also individual customers with us. For example, an engineer rents for work through his company, and in the summer rents for his family on his own account.&quot;&lt;/i&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p dir=&quot;ltr&quot;&gt;&lt;b&gt;Conflict:&lt;/b&gt; If an authorized driver is strictly dependent on a corporate account and loses meaning when the corporate account closes, storing them purely as a weak entity duplicates personal/license data and breaks continuity with their individual customer profile.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;li&gt;&lt;p dir=&quot;ltr&quot;&gt;&lt;b&gt;Checkout Speed Target vs. System Performance Requirement (Section 8 vs. Section 9):&lt;/b&gt;&lt;/p&gt;&lt;ul dir=&quot;ltr&quot;&gt;&lt;li&gt;&lt;p dir=&quot;ltr&quot;&gt;&lt;b&gt;Section 8 (Mr. Hossam Fathy)&lt;/b&gt; states: &lt;i&gt;&quot;Check-out shouldn&#39;t take more than 3 minutes.&quot;&lt;/i&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p dir=&quot;ltr&quot;&gt;&lt;b&gt;Section 9 (NFR-1)&lt;/b&gt; states: &lt;i&gt;&quot;Rental check-out must complete in under 3 seconds of system time.&quot;&lt;/i&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p dir=&quot;ltr&quot;&gt;&lt;b&gt;Conflict:&lt;/b&gt; While 3 minutes may refer to the total counter interaction and 3 seconds to system processing time, the terminology (&quot;check-out&quot;) is used inconsistently across sections without distinguishing user workflow time from transaction response time.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;li&gt;&lt;p dir=&quot;ltr&quot;&gt;&lt;b&gt;Vehicle Category Pricing vs. Individual Vehicle Override (Section 7.3 vs. Section 8):&lt;/b&gt;&lt;/p&gt;&lt;ul dir=&quot;ltr&quot;&gt;&lt;li&gt;&lt;p dir=&quot;ltr&quot;&gt;&lt;b&gt;Section 7.3&lt;/b&gt; states that &lt;i&gt;&quot;Pricing is set per category as a daily rate&quot;&lt;/i&gt; and &lt;i&gt;&quot;Customers do not book a specific car. They book a category,&quot;&lt;/i&gt; followed by a COO note that &lt;i&gt;&quot;Some of our luxury cars, like the Mercedes S-Class we got last year, don&#39;t follow the category price. They have their own price.&quot;&lt;/i&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p dir=&quot;ltr&quot;&gt;&lt;b&gt;Section 8 (Ms. Mai Ibrahim)&lt;/b&gt; asks to &lt;i&gt;&quot;tell the auditors exactly which price we charged on any day in history, for categories, insurance, and extras&quot;&lt;/i&gt; (omitting vehicle-specific price history).&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p dir=&quot;ltr&quot;&gt;&lt;b&gt;Conflict:&lt;/b&gt; Charging a higher vehicle-specific rate at pickup contradicts the category-based reservation pricing model, and the historical pricing requirement in Section 8 does not account for tracking historical rate changes on individual luxury vehicles.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;li&gt;&lt;p dir=&quot;ltr&quot;&gt;&lt;b&gt;Supplier Pricing Model: Variable Prices vs. Fixed Price List (Section 7.15 vs. Section 8):&lt;/b&gt;&lt;/p&gt;&lt;ul dir=&quot;ltr&quot;&gt;&lt;li&gt;&lt;p dir=&quot;ltr&quot;&gt;&lt;b&gt;Section 7.15&lt;/b&gt; states: &lt;i&gt;&quot;The same part can be bought from different suppliers at different prices, and the workshop wants to know each supplier&#39;s price and delivery lead time (in days) for each part they supply.&quot;&lt;/i&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p dir=&quot;ltr&quot;&gt;&lt;b&gt;Section 8 (Mr. Tarek Saleh)&lt;/b&gt; states: &lt;i&gt;&quot;I also want a fixed price list from each supplier per part.&quot;&lt;/i&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p dir=&quot;ltr&quot;&gt;&lt;b&gt;Conflict:&lt;/b&gt; It is unclear whether supplier part prices change over time (requiring historical price tracking like rental rates) or remain fixed per supplier-part agreement.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;li&gt;&lt;p dir=&quot;ltr&quot;&gt;&lt;b&gt;Payroll Scope Exclusion vs. Storing Employee Salaries (Section 1.3 &amp;amp; 10 vs. Section 7.1 &amp;amp; 9):&lt;/b&gt;&lt;/p&gt;&lt;ul dir=&quot;ltr&quot;&gt;&lt;li&gt;&lt;p dir=&quot;ltr&quot;&gt;&lt;b&gt;Sections 1.3 and 10&lt;/b&gt; explicitly state that &lt;i&gt;&quot;HR payroll calculations&quot;&lt;/i&gt; and &lt;i&gt;&quot;Payroll and salary calculation&quot;&lt;/i&gt; are &lt;b&gt;out of scope&lt;/b&gt; for Phase 1.&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p dir=&quot;ltr&quot;&gt;&lt;b&gt;Sections 7.1 and 9 (NFR-3)&lt;/b&gt; require the system to store every employee&#39;s &lt;code&gt;salary&lt;/code&gt; and enforce role-based security so &lt;i&gt;&quot;agents cannot view salaries.&quot;&lt;/i&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p dir=&quot;ltr&quot;&gt;&lt;b&gt;Conflict:&lt;/b&gt; Even though payroll calculation is out of scope, base salary data and its access-control rules are still in scope for the database schema.&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;" vertex="1">
          <mxGeometry height="695" width="980" x="20" y="36" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="C5yWzTLivvZUxIn8V8w2" name=" 4-Business-Rules">
    <mxGraphModel dx="1857" dy="562" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ihcFFqAklVHrzIs_6fjV-1" parent="1" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;fixedHeader=1;tableRender=collapsed;fontSize=15;" value="" vertex="1">
          <mxGeometry height="473" width="850" x="-40" y="37" as="geometry" />
        </mxCell>
        <mxCell id="ihcFFqAklVHrzIs_6fjV-2" parent="ihcFFqAklVHrzIs_6fjV-1" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fixedHeader=1;" value="" vertex="1">
          <mxGeometry height="155" width="850" as="geometry" />
        </mxCell>
        <mxCell id="ihcFFqAklVHrzIs_6fjV-3" parent="ihcFFqAklVHrzIs_6fjV-2" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;pointerEvents=1;" value="#" vertex="1">
          <mxGeometry height="155" width="170" as="geometry">
            <mxRectangle height="155" width="170" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ihcFFqAklVHrzIs_6fjV-4" parent="ihcFFqAklVHrzIs_6fjV-2" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;pointerEvents=1;" value="SRS Section" vertex="1">
          <mxGeometry height="155" width="170" x="170" as="geometry">
            <mxRectangle height="155" width="170" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ihcFFqAklVHrzIs_6fjV-5" parent="ihcFFqAklVHrzIs_6fjV-2" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;pointerEvents=1;" value="Business Rule" vertex="1">
          <mxGeometry height="155" width="170" x="340" as="geometry">
            <mxRectangle height="155" width="170" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ihcFFqAklVHrzIs_6fjV-6" parent="ihcFFqAklVHrzIs_6fjV-2" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;pointerEvents=1;" value="Why Constraints Are Not Enough" vertex="1">
          <mxGeometry height="155" width="170" x="510" as="geometry">
            <mxRectangle height="155" width="170" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
